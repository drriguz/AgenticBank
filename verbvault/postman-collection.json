{
  "info": {
    "name": "AI ATM Simulator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Create Account (Alice)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Alice\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            }
          }
        },
        {
          "name": "Create Account (Bob)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Bob\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            }
          }
        },
        {
          "name": "Get Account Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/accounts/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "1"]
            }
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/accounts/1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "1", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "Transaction",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": 1, \"amount\": 1000.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "deposit"]
            }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": 1, \"amount\": 200.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "withdraw"]
            }
          }
        },
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fromAccountId\": 1, \"toAccountId\": 2, \"amount\": 300.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "transfer"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Withdraw - Insufficient Balance (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": 1, \"amount\": 99999.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "withdraw"]
            }
          }
        },
        {
          "name": "Transfer - Self Transfer (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fromAccountId\": 1, \"toAccountId\": 1, \"amount\": 50.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "transfer"]
            }
          }
        },
        {
          "name": "Get Non-existent Account (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/accounts/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "999"]
            }
          }
        },
        {
          "name": "Deposit - Negative Amount (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": 1, \"amount\": -50.00}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "deposit"]
            }
          }
        }
      ]
    }
  ]
}
